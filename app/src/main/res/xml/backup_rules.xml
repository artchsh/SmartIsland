<!--
  Legacy cloud-backup rules (Android 11 / API 30 and below).

  Dot Island stores notification titles, message bodies and app names in a
  local SQLite database. That content is private to the device and must never
  be copied into a cloud backup or a device-to-device transfer.

  Every backup domain is excluded explicitly. An empty <full-backup-content />
  element is NOT equivalent: it means "back up everything", which is why this
  file previously leaked notification history to Google Drive.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
